# Copia este archivo a `.env.local` y ajusta los valores.
# Se carga automáticamente cuando DJANGO_ENV=local (valor por defecto).

DJANGO_ENV=local

# Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=cambia-esto-por-una-clave-aleatoria

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Opcional: en local se usa SQLite por defecto (db.sqlite3).
# DATABASE_URL=sqlite:///db.sqlite3

CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
