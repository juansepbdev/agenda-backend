# Copia este archivo a `.env.production` para poder correr producción en local.
# En Vercel NO se sube: estas mismas variables se definen en
# Project Settings -> Environment Variables.

DJANGO_ENV=production

SECRET_KEY=clave-secreta-de-produccion

# -----------------------------------------------------------------------------
# Base de datos (Supabase)
# -----------------------------------------------------------------------------
# Opción A (recomendada): variables sueltas. Úsala si la contraseña tiene
# caracteres especiales (! % @ / # ...), porque no hay que codificarlos.
DB_NAME=postgres
DB_USER=postgres.xxxxxxxxxxxxxxxxxxxx
DB_PASSWORD=tu-password-de-supabase
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=6543
DB_SSLMODE=require

# Opción B: una sola URL. Solo se usa si DB_HOST está vacío.
# OJO: la contraseña debe ir URL-encoded (! -> %21, % -> %25, @ -> %40, . se deja igual).
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD_ENCODED@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# -----------------------------------------------------------------------------
# Hosts, HTTPS y orígenes
# -----------------------------------------------------------------------------
# En local (gunicorn sobre http://) pon USE_HTTPS=False.
# En Vercel pon USE_HTTPS=True.
USE_HTTPS=False

ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

FRONTEND_URL=https://agenda-frontend-gamma.vercel.app
# BACKEND_URL=https://tu-backend.vercel.app
# DJANGO_DOMAIN=api.tudominio.com

CSRF_TRUSTED_ORIGINS=https://*.vercel.app,http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
